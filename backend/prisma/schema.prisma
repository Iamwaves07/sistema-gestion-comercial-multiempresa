generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        Int     @id @default(autoincrement())
  nombre    String
  rut       String  @unique
  correo    String
  telefono String?
  direccion String?
  estado    Boolean @default(true)
}