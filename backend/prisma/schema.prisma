generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        Int     @id @default(autoincrement())
  nombre    String
  rut       String  @unique
  correo    String
  telefono String?
  direccion String?
  estado    Boolean @default(true)

  usuarios   Usuario[]
  categorias Categoria[]
  productos  Producto[]
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  estado      Boolean @default(true)

  usuarios Usuario[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  empresaId Int
  rolId     Int
  nombre    String
  correo    String  @unique
  password  String
  estado    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@index([empresaId])
  @@index([rolId])
}

model Categoria {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  nombre      String
  descripcion String?
  estado      Boolean @default(true)

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model Producto {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  categoriaId Int
  nombre      String
  precio      Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  stockMinimo Int     @default(0)
  estado      Boolean @default(true)

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@index([empresaId])
  @@index([categoriaId])
}