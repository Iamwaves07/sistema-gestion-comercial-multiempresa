generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

model Empresa {
  id        Int     @id @default(autoincrement())
  nombre    String
  rut       String  @unique
  correo    String
  telefono String?
  direccion String?
  estado    Boolean @default(true)

  usuarios    Usuario[]
  categorias  Categoria[]
  productos   Producto[]
  clientes    Cliente[]
  movimientos MovimientoInventario[]
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  estado      Boolean @default(true)

  usuarios Usuario[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  empresaId Int
  rolId     Int
  nombre    String
  correo    String  @unique
  password  String
  estado    Boolean @default(true)

  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  rol         Rol                    @relation(fields: [rolId], references: [id])
  movimientos MovimientoInventario[]

  @@index([empresaId])
  @@index([rolId])
}

model Categoria {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  nombre      String
  descripcion String?
  estado      Boolean @default(true)

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model Producto {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  categoriaId Int
  nombre      String
  precio      Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  stockMinimo Int     @default(0)
  estado      Boolean @default(true)

  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  categoria   Categoria              @relation(fields: [categoriaId], references: [id])
  movimientos MovimientoInventario[]

  @@index([empresaId])
  @@index([categoriaId])
}

model Cliente {
  id        Int     @id @default(autoincrement())
  empresaId Int
  nombre    String
  rut       String
  correo    String?
  telefono String?
  direccion String?
  estado    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, rut])
  @@index([empresaId])
}

model MovimientoInventario {
  id            Int                      @id @default(autoincrement())
  empresaId     Int
  productoId    Int
  usuarioId     Int
  tipo          TipoMovimientoInventario
  cantidad      Int
  observacion   String?
  fechaCreacion DateTime                 @default(now())

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, fechaCreacion])
  @@index([productoId])
  @@index([usuarioId])
}