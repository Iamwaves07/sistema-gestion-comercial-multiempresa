generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        Int       @id @default(autoincrement())
  nombre    String
  rut       String    @unique
  correo    String
  telefono String?
  direccion String?
  estado    Boolean   @default(true)

  usuarios  Usuario[]
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  estado      Boolean   @default(true)

  usuarios    Usuario[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  empresaId Int
  rolId     Int
  nombre    String
  correo    String  @unique
  password  String
  estado    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])
}