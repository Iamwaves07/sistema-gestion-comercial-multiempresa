generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

enum EstadoVenta {
  PENDIENTE_PAGO
  CONFIRMADA
  ANULADA
}

enum EstadoOrdenCompra {
  BORRADOR
  EMITIDA
  RECIBIDA
  ANULADA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  ANULADO
}

model Empresa {
  id        Int     @id @default(autoincrement())
  nombre    String
  rut       String  @unique
  correo    String
  telefono String?
  direccion String?
  estado    Boolean @default(true)

  usuarios      Usuario[]
  categorias    Categoria[]
  productos     Producto[]
  clientes      Cliente[]
  movimientos   MovimientoInventario[]
  cotizaciones  Cotizacion[]
  ventas        Venta[]
  proveedores   Proveedor[]
  ordenesCompra OrdenCompra[]
  pagos         Pago[]
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  estado      Boolean @default(true)

  usuarios Usuario[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  empresaId Int
  rolId     Int
  nombre    String
  correo    String  @unique
  password  String
  estado    Boolean @default(true)

  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  rol           Rol                    @relation(fields: [rolId], references: [id])
  movimientos   MovimientoInventario[]
  cotizaciones  Cotizacion[]
  ventas        Venta[]
  ordenesCompra OrdenCompra[]
  pagos         Pago[]

  @@index([empresaId])
  @@index([rolId])
}

model Categoria {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  nombre      String
  descripcion String?
  estado      Boolean @default(true)

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model Producto {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  categoriaId Int
  nombre      String
  precio      Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  stockMinimo Int     @default(0)
  estado      Boolean @default(true)

  empresa             Empresa                @relation(fields: [empresaId], references: [id])
  categoria           Categoria              @relation(fields: [categoriaId], references: [id])
  movimientos         MovimientoInventario[]
  detallesCotizacion  DetalleCotizacion[]
  detallesVenta       DetalleVenta[]
  detallesOrdenCompra DetalleOrdenCompra[]

  @@index([empresaId])
  @@index([categoriaId])
}

model Cliente {
  id        Int     @id @default(autoincrement())
  empresaId Int
  nombre    String
  rut       String
  correo    String?
  telefono String?
  direccion String?
  estado    Boolean @default(true)

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  cotizaciones Cotizacion[]
  ventas       Venta[]

  @@unique([empresaId, rut])
  @@index([empresaId])
}

model Proveedor {
  id          Int     @id @default(autoincrement())
  empresaId   Int
  razonSocial String
  rut         String
  giro        String?
  correo      String?
  telefono    String?
  direccion   String?
  estado      Boolean @default(true)

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  ordenesCompra OrdenCompra[]

  @@unique([empresaId, rut])
  @@index([empresaId])
}

model MovimientoInventario {
  id            Int                      @id @default(autoincrement())
  empresaId     Int
  productoId    Int
  usuarioId     Int
  ventaId       Int?
  ordenCompraId Int?
  tipo          TipoMovimientoInventario
  cantidad      Int
  observacion   String?
  fechaCreacion DateTime                 @default(now())

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  producto    Producto     @relation(fields: [productoId], references: [id])
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  venta       Venta?       @relation(fields: [ventaId], references: [id])
  ordenCompra OrdenCompra? @relation(fields: [ordenCompraId], references: [id])

  @@index([empresaId, fechaCreacion])
  @@index([productoId])
  @@index([usuarioId])
  @@index([ventaId])
  @@index([ordenCompraId])
}

model Cotizacion {
  id                 Int              @id @default(autoincrement())
  empresaId          Int
  clienteId          Int
  usuarioId          Int
  numero             String
  estado             EstadoCotizacion @default(BORRADOR)
  observacion        String?
  subtotal           Decimal          @db.Decimal(12, 2)
  total              Decimal          @db.Decimal(12, 2)
  fechaCreacion      DateTime         @default(now())
  fechaVencimiento   DateTime?
  fechaActualizacion DateTime         @updatedAt

  empresa  Empresa              @relation(fields: [empresaId], references: [id])
  cliente  Cliente              @relation(fields: [clienteId], references: [id])
  usuario  Usuario              @relation(fields: [usuarioId], references: [id])
  detalles DetalleCotizacion[]
  venta    Venta?

  @@unique([empresaId, numero])
  @@index([empresaId, fechaCreacion])
  @@index([clienteId])
  @@index([usuarioId])
}

model DetalleCotizacion {
  id             Int     @id @default(autoincrement())
  cotizacionId   Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   Producto   @relation(fields: [productoId], references: [id])

  @@unique([cotizacionId, productoId])
  @@index([cotizacionId])
  @@index([productoId])
}

model Venta {
  id                 Int         @id @default(autoincrement())
  empresaId          Int
  clienteId          Int
  usuarioId          Int
  cotizacionId       Int?        @unique
  numero             String
  estado             EstadoVenta @default(CONFIRMADA)

  // Suma de los precios finales de venta.
  // Los precios de Producto ya incluyen IVA.
  subtotal           Decimal     @db.Decimal(12, 2)

  // Desglose tributario de la venta.
  // Se mantienen opcionales para conservar compatibilidad
  // con las ventas históricas creadas antes de v0.20.0.
  subtotalNeto       Decimal?    @db.Decimal(12, 2)
  tasaIva            Decimal     @default(19.00) @db.Decimal(5, 2)
  montoIva           Decimal?    @db.Decimal(12, 2)

  // Total final cobrado al cliente, IVA incluido.
  total              Decimal     @db.Decimal(12, 2)

  observacion        String?
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt

  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  cliente     Cliente                @relation(fields: [clienteId], references: [id])
  usuario     Usuario                @relation(fields: [usuarioId], references: [id])
  cotizacion  Cotizacion?            @relation(fields: [cotizacionId], references: [id])
  detalles    DetalleVenta[]
  movimientos MovimientoInventario[]
  pagos       Pago[]

  @@unique([empresaId, numero])
  @@index([empresaId, fechaCreacion])
  @@index([clienteId])
  @@index([usuarioId])
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int

  // Precio final unitario del producto, IVA incluido.
  precioUnitario Decimal @db.Decimal(12, 2)

  // Subtotal final de la línea, IVA incluido.
  subtotal       Decimal @db.Decimal(12, 2)

  // Neto histórico de la línea.
  // Opcional para mantener compatibilidad con ventas previas.
  subtotalNeto   Decimal? @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([ventaId, productoId])
  @@index([ventaId])
  @@index([productoId])
}

model Pago {
  id        Int        @id @default(autoincrement())
  empresaId Int
  ventaId   Int
  usuarioId Int

  // Monto enviado al proveedor de pagos.
  // Debe coincidir con Venta.total.
  monto Decimal @db.Decimal(12, 2)

  // Estado interno del intento de pago.
  estado EstadoPago @default(PENDIENTE)

  // Para este MVP utilizaremos Transbank Webpay Plus.
  proveedor String @default("TRANSBANK_WEBPAY_PLUS")

  // Identificadores utilizados para iniciar y confirmar
  // la transacción con el proveedor.
  buyOrder  String @unique
  sessionId String
  token     String? @unique

  // Información devuelta por el proveedor al confirmar
  // la transacción. No almacenamos PAN ni CVV.
  codigoAutorizacion String?
  codigoRespuesta    Int?
  tipoPago           String?
  numeroCuotas       Int?

  fechaCreacion      DateTime  @default(now())
  fechaResolucion    DateTime?
  fechaActualizacion DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  venta   Venta   @relation(fields: [ventaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, fechaCreacion])
  @@index([ventaId])
  @@index([usuarioId])
  @@index([estado])
}

model OrdenCompra {
  id                 Int               @id @default(autoincrement())
  empresaId          Int
  proveedorId        Int
  usuarioId          Int
  numero             String
  estado             EstadoOrdenCompra @default(BORRADOR)
  observacion        String?
  subtotalNeto       Decimal           @db.Decimal(12, 2)
  tasaIva            Decimal           @default(19.00) @db.Decimal(5, 2)
  montoIva           Decimal           @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  fechaCreacion      DateTime          @default(now())
  fechaEmision       DateTime?
  fechaRecepcion     DateTime?
  fechaActualizacion DateTime          @updatedAt

  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id])
  usuario     Usuario                @relation(fields: [usuarioId], references: [id])
  detalles    DetalleOrdenCompra[]
  movimientos MovimientoInventario[]

  @@unique([empresaId, numero])
  @@index([empresaId, fechaCreacion])
  @@index([proveedorId])
  @@index([usuarioId])
}

model DetalleOrdenCompra {
  id                Int     @id @default(autoincrement())
  ordenCompraId     Int
  productoId        Int
  cantidad          Int
  costoUnitarioNeto Decimal @db.Decimal(12, 2)
  subtotalNeto      Decimal @db.Decimal(12, 2)

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId], references: [id])

  @@unique([ordenCompraId, productoId])
  @@index([ordenCompraId])
  @@index([productoId])
}